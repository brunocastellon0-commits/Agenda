{
  "expo": {
    "name": "agenda-app",
    "slug": "agenda-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/relok.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/relok.png"
      },
      "predictiveBackGestureEnabled": true,
      "package": "com.brunocastellon0.agendaapp"
    },
    "web": {
      "favicon": "./assets/relok.png"
    },
    "splash": {
      "image": "./assets/relok.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "plugins": [
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "MiDiaWidget",
              "label": "Mi Día",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "description": "Resumen de tus hábitos y actividades",
              "previewImage": "./assets/relok.png"
            }
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "8d1b923e-923b-4cbb-9e6f-dc6c05b530c3"
      }
    }
  }
}
